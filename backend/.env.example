# Django and JWT signing key. Use 32 or more random characters. Empty uses a dev-only default.
SECRET_KEY=
# 1 for development, 0 for production. Empty means 1.
DJANGO_DEBUG=
# Comma-separated hostnames. Empty means localhost,127.0.0.1.
ALLOWED_HOSTS=
# Comma-separated frontend origins. Empty means the local Vite and Compose ports.
CORS_ALLOWED_ORIGINS=

# MongoDB connection string. Empty means mongodb://localhost:27017.
MONGO_URI=
# Database name. Empty means keypass.
MONGO_DB_NAME=
# Milliseconds before a Mongo outage returns 503. Empty means 3000.
MONGO_SERVER_TIMEOUT_MS=

# Azure OpenAI API key. Empty disables the AI features.
OPENAI_API_KEY=
# Azure resource base URL, with no path. Empty disables the AI features.
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API version. Empty means 2025-04-01-preview.
AZURE_OPENAI_API_VERSION=
# Azure deployment name. Empty means gpt-5.6-sol.
OPENAI_MODEL=
# Timeout in seconds per AI call. Empty means 60.
OPENAI_TIMEOUT_SECONDS=

# Session length in hours. Empty means 12.
JWT_EXPIRY_HOURS=
